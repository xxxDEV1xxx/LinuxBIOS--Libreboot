cat > /data/p0pppoe-install.sh <<'SCRIPT'
#!/bin/bash
set -Eeuo pipefail
D=/data/lib-ext/p0pppoe
A=/data/lib-ext/apt-cache
O="-o Dir::Cache::archives=$A/archives -o Dir::State::Lists=$A/lists -o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache= -o Debug::NoLocking=1 -o APT::Sandbox::User=root"
mkdir -p $A/archives/partial $A/lists/partial $D/etc-ppp
echo "=== 1. DOWNLOAD"
apt-get $O install --download-only --reinstall -y ppp pppoe 2>&1 | tail -4
ls $A/archives/ppp_*.deb $A/archives/pppoe_*.deb
echo "=== 2. EXTRACT"
rm -rf $D/pkg; mkdir -p $D/pkg
for d in $A/archives/ppp_*.deb $A/archives/pppoe_*.deb; do dpkg-deb -x "$d" $D/pkg; done
echo "=== 3. SYMLINKS"
for b in pppd pppoe-server pppoe; do
  [ -e /usr/sbin/$b ] || ln -sfn $D/pkg/usr/sbin/$b /usr/sbin/$b
done
[ -e /usr/lib/pppd ] || ln -sfn $D/pkg/usr/lib/pppd /usr/lib/pppd
[ -e /etc/ppp ] || ln -sfn $D/etc-ppp /etc/ppp
PLUG=$(find $D/pkg -name rp-pppoe.so | head -1)
test -f "$PLUG" || { echo "ABORT: rp-pppoe.so not found"; exit 1; }
echo "=== 4. CONFIG + VERIFY"
S=$D/etc-ppp
if [ ! -f $S/chap-secrets ]; then
  PW=$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 32)
  ( umask 077; printf 'p0client * %s 10.99.0.2\n' "$PW" > $S/chap-secrets )
fi
: > $S/pap-secrets; chmod 600 $S/chap-secrets $S/pap-secrets
cat > $D/server-options <<EOF
name p0server
require-chap
refuse-pap
refuse-eap
refuse-mschap
refuse-mschap-v2
nodefaultroute
noipdefault
nobsdcomp
nodeflate
mtu 1492
mru 1492
lcp-echo-interval 10
lcp-echo-failure 3
EOF
cat > $D/client-options <<EOF
plugin $PLUG
nic-pn
user p0client
remotename p0server
noauth
refuse-pap
refuse-eap
nodefaultroute
noipdefault
nobsdcomp
nodeflate
mtu 1492
mru 1492
lcp-echo-interval 10
lcp-echo-failure 3
ifname p0c
linkname p0ppp
maxfail 1
updetach
EOF
export LD_LIBRARY_PATH=$D/pkg/usr/lib/x86_64-linux-gnu:$D/pkg/lib/x86_64-linux-gnu
for b in $D/pkg/usr/sbin/pppd $D/pkg/usr/sbin/pppoe-server; do
  echo "ldd $b:"; ldd $b | grep 'not found' || echo "  libs OK"
done
$D/pkg/usr/sbin/pppd --version 2>&1 | head -1
for m in ppp_generic pppoe pppox; do modprobe -n $m && echo "module $m OK"; done
ls -l /etc/ppp /usr/sbin/pppd /usr/sbin/pppoe-server | head -8
echo INSTALL_DONE
SCRIPT
