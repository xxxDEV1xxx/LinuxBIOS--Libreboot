cat > /data/lib-ext/p0pppoe/ctl <<'CTL'
#!/bin/bash
D=/data/lib-ext/p0pppoe; R=/run/p0pppoe
WAN=wg0; LAN=nx0; NS=p0ppp
export LD_LIBRARY_PATH=$D/pkg/usr/lib/x86_64-linux-gnu:$D/pkg/lib/x86_64-linux-gnu
PPPD=$D/pkg/usr/sbin/pppd; SRV=$D/pkg/usr/sbin/pppoe-server
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
exec 9>/run/p0pppoe.lock; flock 9

off_cmd() {
  set +e
  ip rule del iif $LAN lookup 100 priority 100 2>/dev/null
  ip rule del iif $LAN lookup main suppress_prefixlength 0 priority 99 2>/dev/null
  ip route flush table 100 2>/dev/null
  nft delete table inet p0pppoe 2>/dev/null
  nft delete table ip p0pppoe_nat 2>/dev/null
  [ -f /var/run/ppp-p0ppp.pid ] && kill "$(head -1 /var/run/ppp-p0ppp.pid)" 2>/dev/null
  pkill -f "pppd file $D/client-options" 2>/dev/null
  [ -f $R/server.pid ] && kill "$(cat $R/server.pid)" 2>/dev/null
  pkill -f "$D/server-options" 2>/dev/null
  sleep 1
  ip netns del $NS 2>/dev/null
  ip link del lh 2>/dev/null; ip link del ph 2>/dev/null
  [ -f $R/bind ] && umount /etc/ppp 2>/dev/null
  [ -f $R/sysctl ] && while read -r l; do sysctl -qw "$l"; done < $R/sysctl
  if [ -f $R/pre-route ]; then
    ip -4 route show table main | diff -q - $R/pre-route >/dev/null && echo "ROUTES: main table identical to pre-ON" || echo "ROUTES: main table differs from pre-ON (check ip route)"
    ip rule show | diff -q - $R/pre-rule >/dev/null && echo "RULES: identical to pre-ON" || echo "RULES: differ from pre-ON (check ip rule)"
  fi
  rm -rf $R
  echo "pppoe: OFF"
}

on_cmd() {
  [ -d $R ] && { echo "pppoe: already on (or run: pppoe off)"; return 0; }
  ip link show $WAN >/dev/null 2>&1 && ip link show $LAN >/dev/null 2>&1 || { echo "ABORT: $WAN/$LAN not on host (NICs handed to VM?)"; return 1; }
  [ -z "$(ip route show table 100 2>/dev/null)" ] || { echo "ABORT: routing table 100 in use"; return 1; }
  [ -x $PPPD ] && [ -x $SRV ] || { echo "ABORT: run /data/p0pppoe-install.sh first"; return 1; }
  mkdir -p $R
  set -Ee
  trap 'trap - ERR; echo "pppoe: FAILED at line $LINENO; rolling back"; off_cmd; return 1' ERR
  ip -4 route show table main > $R/pre-route; ip rule show > $R/pre-rule; nft list ruleset > $R/pre-nft
  for m in ppp_generic pppoe pppox; do modprobe $m; done
  for k in net.ipv4.ip_forward net.ipv4.conf.all.rp_filter net.ipv4.conf.$LAN.rp_filter; do echo "$k=$(sysctl -n $k)" >> $R/sysctl; done
  sysctl -qw net.ipv4.ip_forward=1
  for k in net.ipv4.conf.all.rp_filter net.ipv4.conf.$LAN.rp_filter; do [ "$(sysctl -n $k)" = 1 ] && sysctl -qw $k=2; done
  # namespace + links
  ip netns add $NS
  ip link add lh type veth peer name ln
  ip link add ph type veth peer name pn
  ip link set ln netns $NS; ip link set pn netns $NS
  ip addr add 10.98.0.1/30 dev lh; ip link set lh up; ip link set ph up
  sysctl -qw net.ipv4.conf.lh.rp_filter=2
  ip -n $NS addr add 10.98.0.2/30 dev ln
  ip -n $NS link set lo up; ip -n $NS link set ln up; ip -n $NS link set pn up
  # ppp config dir
  if [ "$(readlink -f /etc/ppp)" != "$D/etc-ppp" ]; then mount --bind $D/etc-ppp /etc/ppp; echo 1 > $R/bind; fi
  # PPPoE server (host end) and client (namespace end)
  $SRV -I ph -L 10.99.0.1 -R 10.99.0.2 -N 1 -C p0pppoe -S p0pppoe -k -X $R/server.pid -O $D/server-options
  sleep 1
  timeout 40 ip netns exec $NS $PPPD file $D/client-options
  ip -n $NS addr show dev p0c | grep -q 10.99.0.2
  ip -n $NS route add default dev p0c
  ip netns exec $NS sysctl -qw net.ipv4.ip_forward=1 net.ipv4.conf.all.rp_filter=0
  ip netns exec $NS nft -f - <<NSNFT
table ip p0ns {
  chain post { type nat hook postrouting priority 100; oifname "p0c" masquerade }
  chain fwd { type filter hook forward priority 0; policy drop;
    iifname "p0c" tcp flags syn tcp option maxseg size > 1452 tcp option maxseg size set 1452
    oifname "p0c" tcp flags syn tcp option maxseg size > 1452 tcp option maxseg size set 1452
    iifname "ln" oifname "p0c" accept
    iifname "p0c" oifname "ln" ct state established,related accept
  }
}
NSNFT
  nft -f - <<HNFT
table inet p0pppoe {
  chain fwd { type filter hook forward priority -5; policy accept;
    iifname "ppp*" oifname != "$WAN" drop
    iifname "ppp*" ip saddr != 10.99.0.2 drop
    iifname "$WAN" oifname "ppp*" ct state new drop
    iifname "lh" ct state new drop
  }
}
table ip p0pppoe_nat {
  chain post { type nat hook postrouting priority 90; ip saddr 10.99.0.0/24 oifname "$WAN" masquerade }
}
HNFT
  # link test BEFORE cutover; failure rolls back without touching LAN routing
  ip netns exec $NS ping -c2 -W3 -I p0c 1.1.1.1 >/dev/null || { echo "PPP link test failed (no path via $WAN)"; false; }
  ip route add default via 10.98.0.2 dev lh table 100
  ip rule add iif $LAN lookup main suppress_prefixlength 0 priority 99
  ip rule add iif $LAN lookup 100 priority 100
  trap - ERR; set +E
  echo "pppoe: ON ($LAN clients -> lh -> $NS -> PPPoE -> $WAN)"
}

status_cmd() {
  [ -d $R ] && echo "pppoe: ON" || echo "pppoe: OFF"
  ip rule show | grep -E 'priority|lookup (100|main suppress)' | grep -E '^(99|100):' || true
  ip -br addr show 2>/dev/null | grep -E '^(lh|ph|ppp)' || true
  ip -n $NS -br addr 2>/dev/null | grep -E 'p0c|ln' || true
}

case "${1:-}" in
  on) on_cmd ;; off) off_cmd ;; status) status_cmd ;;
  *) echo "usage: pppoe on|off|status" ;;
esac
CTL
chmod 755 /data/lib-ext/p0pppoe/ctl
printf '%s\n' 'pppoe() { /data/lib-ext/p0pppoe/ctl "$@"; }' > /data/lib-ext/p0pppoe/pppoe-func.sh
bash -n /data/lib-ext/p0pppoe/ctl && echo SYNTAX_OK
grep -q pppoe-func /root/.bashrc || echo '. /data/lib-ext/p0pppoe/pppoe-func.sh' >> /root/.bashrc
. /data/lib-ext/p0pppoe/pppoe-func.sh

