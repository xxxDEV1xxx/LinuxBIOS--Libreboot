from pathlib import Path
import re
import sys

p = Path(sys.argv[1])
s = p.read_text()

helpers = r'''
# All PPPoE firewall exceptions belong to this controller's ON/OFF lifecycle.
# Append after existing CTW security-chain checks; never bypass them.

add_forward_rule() {
    local tag=$1
    shift

    if ! iptables -C FORWARD "$@" >/dev/null 2>&1; then
        iptables -A FORWARD "$@"
    fi

    : > "$R/fw-$tag"
}

remove_forward_rules() {
    if [ -f "$R/fw-lan-out" ]; then
        while iptables -C FORWARD -i "$LAN" -o lh \
            -s 192.168.254.0/24 -j ACCEPT 2>/dev/null; do
            iptables -D FORWARD -i "$LAN" -o lh \
                -s 192.168.254.0/24 -j ACCEPT
        done
        rm -f "$R/fw-lan-out"
    fi

    if [ -f "$R/fw-lan-return" ]; then
        while iptables -C FORWARD -i lh -o "$LAN" \
            -d 192.168.254.0/24 \
            -m conntrack --ctstate ESTABLISHED,RELATED \
            -j ACCEPT 2>/dev/null; do
            iptables -D FORWARD -i lh -o "$LAN" \
                -d 192.168.254.0/24 \
                -m conntrack --ctstate ESTABLISHED,RELATED \
                -j ACCEPT
        done
        rm -f "$R/fw-lan-return"
    fi

    if [ -f "$R/fw-ppp-out" ]; then
        while iptables -C FORWARD -i ppp+ -o "$WAN" \
            -s 10.99.0.2/32 -j ACCEPT 2>/dev/null; do
            iptables -D FORWARD -i ppp+ -o "$WAN" \
                -s 10.99.0.2/32 -j ACCEPT
        done
        rm -f "$R/fw-ppp-out"
    fi

    if [ -f "$R/fw-ppp-return" ]; then
        while iptables -C FORWARD -i "$WAN" -o ppp+ \
            -d 10.99.0.2/32 \
            -m conntrack --ctstate ESTABLISHED,RELATED \
            -j ACCEPT 2>/dev/null; do
            iptables -D FORWARD -i "$WAN" -o ppp+ \
                -d 10.99.0.2/32 \
                -m conntrack --ctstate ESTABLISHED,RELATED \
                -j ACCEPT
        done
        rm -f "$R/fw-ppp-return"
    fi
}

install_forward_rules() {
    command -v iptables >/dev/null || {
        echo "ABORT: iptables unavailable"
        return 1
    }

    add_forward_rule lan-out \
        -i "$LAN" -o lh \
        -s 192.168.254.0/24 -j ACCEPT

    add_forward_rule lan-return \
        -i lh -o "$LAN" \
        -d 192.168.254.0/24 \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

    add_forward_rule ppp-out \
        -i ppp+ -o "$WAN" \
        -s 10.99.0.2/32 -j ACCEPT

    add_forward_rule ppp-return \
        -i "$WAN" -o ppp+ \
        -d 10.99.0.2/32 \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
}
'''

# Replace the complete prior helper block, or insert it before off_cmd.
start = s.find("add_forward_rule() {")
off = s.find("off_cmd() {")

if off < 0:
    raise SystemExit("ABORT: off_cmd not found")

if start >= 0 and start < off:
    s = s[:start] + helpers + "\n" + s[off:]
else:
    s = s[:off] + helpers + "\n" + s[off:]

# OFF must remove rules before deleting runtime state.
off = s.find("off_cmd() {")
end = s.find("\non_cmd() {", off)
if off < 0 or end < 0:
    raise SystemExit("ABORT: cannot identify ON/OFF functions")

off_body = s[off:end]
calls = len(re.findall(r"(?m)^\s*remove_forward_rules\s*$", off_body))

if calls == 0:
    if "set +e" not in off_body:
        raise SystemExit("ABORT: off_cmd set +e not found")
    off_body = off_body.replace(
        "set +e",
        "set +e\n  remove_forward_rules",
        1
    )
elif calls != 1:
    raise SystemExit(f"ABORT: unexpected remove_forward_rules calls: {calls}")

s = s[:off] + off_body + s[end:]

# ON must install rules before its pre-cutover connectivity test.
marker = "# link test BEFORE cutover"
if marker not in s:
    raise SystemExit("ABORT: pre-cutover test marker missing")

if len(re.findall(r"(?m)^\s*install_forward_rules\s*$", s)) == 0:
    s = s.replace(marker, "  install_forward_rules\n" + marker, 1)
elif len(re.findall(r"(?m)^\s*install_forward_rules\s*$", s)) != 1:
    raise SystemExit("ABORT: unexpected install_forward_rules call count")

# Give the namespace an explicit return route to the LAN.
old_route = "  ip -n $NS route add default dev p0c"
new_route = (
    old_route + "\n"
    "  ip -n $NS route replace 192.168.254.0/24 "
    "via 10.98.0.1 dev ln"
)

if old_route in s:
    s = s.replace(old_route, new_route, 1)
elif "ip -n $NS route replace 192.168.254.0/24 via 10.98.0.1 dev ln" not in s:
    raise SystemExit("ABORT: namespace default route insertion point missing")

p.write_text(s)
print("PPPoE ON/OFF lifecycle updated.")
PY

