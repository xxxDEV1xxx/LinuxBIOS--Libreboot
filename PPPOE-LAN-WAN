lba32
boot=$L
disk=$L bios=0x80 sectors=63 heads=16 cylinders=$CYL max-partitions=7
  partition=${L}p1
    start=2048
map=/boot/map
install=menu
prompt
timeout=50
default=dsls
image=/boot/vmlinuz-$KVER
  label=dsls
  initrd=/boot/initrd.img-$KVER
  read-only
  append="root=/dev/sda1 rootfstype=ext4 console=tty0 console=ttyS0,115200n8 systemd.mask=p0-reverseshell-v3.service"
EOF
mkdir -p "$M/dev" "$M/proc" "$M/sys"
mount --bind /dev "$M/dev"; mount --bind /proc "$M/proc"
"$LILOBIN" -r "$M" -C /etc/lilo.conf -P ignore -v
sync

echo "=== 5. VERIFY"
[ "$(dd if="$L" bs=512 count=1 2>/dev/null | grep -a -c LILO)" -ge 1 ] && echo MBR_LILO=PASS || { echo MBR_LILO=FAIL; exit 1; }
stat -c '%F  %n' "$M/data/lib-ext" "$M/data/lib-ext/p0pppoe/ctl" "$M/data/lib-ext/p0pppoe/pkg/usr/sbin/pppd"
