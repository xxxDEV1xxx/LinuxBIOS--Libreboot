touch /data/sda4/.wtest && rm -f /data/sda4/.wtest || { echo "ABORT: /data/sda4 not writable"; exit 1; }
MB=$(( $(du -sm "$SRC" | cut -f1) + 2048 ))
df -h /data/sda4 | tail -1; echo "image size: ${MB}M"
modprobe loop 2>/dev/null || true
umount -R "$M" 2>/dev/null || true
mkdir -p "$M"

echo "=== 1. CREATE IMAGE"
qemu-img create -f raw "$NEW" ${MB}M
parted -s "$NEW" mklabel msdos mkpart primary ext4 1MiB 100% set 1 boot on
L=$(losetup -Pf --show "$NEW")
trap 'umount -R "$M" 2>/dev/null || true; losetup -d "$L" 2>/dev/null || true' EXIT
for i in 1 2 3 4 5; do test -b "${L}p1" && break; sleep 1; done
test -b "${L}p1" || { echo "ABORT: ${L}p1 missing"; exit 1; }
mkfs.ext4 -F -L LILOROOT "${L}p1"
mount "${L}p1" "$M"

echo "=== 2. COPY TREE"
rsync -aHAX --exclude=/boot/grub --exclude=/boot.catalog --exclude=/isolinux "$SRC"/ "$M"/

